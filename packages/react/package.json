{
  "name": "@crfrsr/ui",
  "version": "1.1.0",
  "description": "crfrsr Design System components for React (web)",
  "keywords": [
    "design-system",
    "react",
    "components",
    "typography",
    "theme",
    "dark-mode",
    "crfrsr"
  ],
  "author": "Cristian Fraser",
  "license": "MIT",
  "homepage": "https://github.com/cristianfraser/crfrsr#readme",
  "bugs": {
    "url": "https://github.com/cristianfraser/crfrsr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristianfraser/crfrsr.git",
    "directory": "packages/react"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reset.css": "./dist/styles/reset.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./styles.css": "./dist/styles/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-styles.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@crfrsr/core": "^1.0.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@tanstack/react-virtual": "^3.10.8",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
